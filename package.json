{
  "name": "websystem-unlocker",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node api/server.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node api/server.mjs",
    "inspect:web": "node scripts/web-inspector.mjs"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "nodemailer": "^7.0.10"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "puppeteer-core": "^24.0.0"
  },
  "type": "module"
}
